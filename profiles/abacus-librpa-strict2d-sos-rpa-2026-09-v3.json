      },
      "deprecated_values": {"task": {"g0w0_band": "g0w0"}},
      "reader_versions": [-1, 0, 1],
      "frequency_grids": {
        "default": "minimax",
        "default_nfreq": 16,
        "recognized_types": ["GL", "split-GL", "GC-I", "GL-II", "minimax", "evenspaced", "evenspaced_tf"],
