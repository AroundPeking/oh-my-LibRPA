# Baseline template: periodic GW + shrink + symmetry lane.
# Do not reuse this file for the short molecular GW route; materialize `routes/molecule-gw-no-nscf-no-pyatb-no-shrink/` instead.
# Do not use the symmetry flags below for SOC cases.
task = g0w0
tfgrids_type = minimax
nfreq = 24
n_params_anacon = 6
option_qpe_solver = 0
use_qpe_adaptive_damp = f
option_dielect_func = 3
replace_w_head = t
prefix_coul_full = v1_coulomb_full_iq_
prefix_coul_cut = v1_coulomb_cut_iq_
prefix_eigvecs_scf = KS_eigenvector
prefix_lri_coeff = v1_Cs_data_
prefix_lri_coeff_shrink = v1_Cs_shrinked_data_
prefix_shrink_sinvS = v1_shrink_sinvS_
fn_stru = stru_out
fn_bz_sampling = bz_sampling_out
fn_basis_wfc = basis_wfc_out
fn_basis_aux = basis_aux_out
fn_basis_aux_shrink = basis_aux_shrink_out
fn_eigocc_scf = band_out
fn_vxc_scf = vxc_out
version_coul_reader = 1
version_lri_reader = 1
use_scalapack_gw_wc = t
use_cholesky_gw_wc = t
use_elpa_sqrt_coulomb = t
parallel_routing = libri
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_shrink_abfs = t
# SOC cases should keep these flags disabled.
use_symmetry_exx = t
use_symmetry_gw = t
use_fullcoul_exx = f
use_kpara_scf_eigvec = t
libri_chi0_collect_max_bytes = 2147483648

# Keep disabled by default. Enable only for explicit NSCF band-continuation requests.
output_gw_sigc_mat_rf = f

libri_chi0_threshold_C = 1e-4
libri_chi0_threshold_G = 1e-5
libri_exx_threshold_V = 1e-1
libri_exx_threshold_C = 1e-4
libri_exx_threshold_D = 1e-4
libri_g0w0_threshold_C = 1e-5
libri_g0w0_threshold_G = 1e-5
libri_g0w0_threshold_Wc = 1e-6

#debug = t
